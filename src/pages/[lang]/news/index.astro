---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '@/i18n';

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout title={t('nav.news')}>
  <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
    <div class="absolute top-1/3 right-1/4 w-80 h-80 bg-white/5 rounded-full blur-3xl"></div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-5 py-2 mb-6">
        <span class="w-1.5 h-1.5 bg-white/60 rounded-full"></span>
        <span class="text-white/70 text-sm font-medium tracking-widest uppercase">News</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
        {t('nav.news')}
      </h1>
      <p class="text-xl text-gray-400">
        {t('news.hero.subtitle')}
      </p>
    </div>
  </section>
</BaseLayout>
