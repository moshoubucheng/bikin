---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactModal from '@/components/ContactModal.astro';
import { useTranslations, getLocalizedContent, type Lang, isValidLang } from '@/i18n';
import { getCollection } from 'astro:content';
import { sanitizeHtml } from '@/utils/sanitize';

const { lang: paramLang, slug } = Astro.params;

if (!paramLang || !isValidLang(paramLang)) {
  return Astro.redirect('/zh/estate');
}
const lang = paramLang as Lang;
const t = useTranslations(lang);

const allProperties = await getCollection('properties');
const property = allProperties.find((p) => p.id.split('/')[0] === slug);

if (!property) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const title = getLocalizedContent(property.data.title, lang) || '';
const location = getLocalizedContent(property.data.location, lang) || '';
const features = property.data.features || [];
const description = getLocalizedContent(property.data.description ?? {}, lang) || '';

// 图片列表
const images = property.data.images || [];
const mainImage = images[0];
---

<BaseLayout title={title} theme="estate">
  <!-- 返回按钮 -->
  <section class="bg-neutral-900 pt-20 pb-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <a
        href={`/${lang}/estate`}
        class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        {t('common.back')}
      </a>
    </div>
  </section>

  <!-- Hero 标题区 -->
  <section class="bg-neutral-900 pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          {property.data.featured && (
            <div class="mb-4">
              <span class="px-3 py-1 bg-estate-500 text-white rounded-full text-sm font-medium">
                {t('estate.featured')}
              </span>
            </div>
          )}
          <h1 class="text-3xl md:text-4xl font-bold text-white mb-3">{title}</h1>
          <p class="text-gray-400 flex items-center gap-2">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            {location}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 图片画廊 -->
  <section class="py-12 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <!-- 主图：全宽大图 -->
      {mainImage && (
        <div class="w-full aspect-[16/9] rounded-2xl overflow-hidden bg-estate-100">
          <img
            src={typeof mainImage === 'string' ? mainImage : mainImage.src}
            alt={title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <!-- 其余图片：3列网格，每张都够大 -->
      {images.length > 1 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {images.slice(1).map((img, i) => (
            <div class="aspect-[4/3] rounded-xl overflow-hidden bg-estate-100">
              <img
                src={typeof img === 'string' ? img : img.src}
                alt={`${title} - ${i + 2}`}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
              />
            </div>
          ))}
        </div>
      )}
    </div>
  </section>

  <!-- 详情信息 -->
  <section class="py-12 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-12">
        <!-- 左侧：特色 + 正文 -->
        <div class="lg:col-span-2 space-y-10">
          <!-- 项目特色 -->
          {features.length > 0 && (
            <div>
              <h2 class="text-2xl font-bold text-gray-900 mb-5">{t('estate.detail.features')}</h2>
              <ul class="grid sm:grid-cols-2 gap-3">
                {features.map((feature) => (
                  <li class="flex items-center gap-3 text-gray-700">
                    <svg class="w-5 h-5 text-estate-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {getLocalizedContent(feature, lang)}
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- 项目介绍正文 -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-5">{t('estate.detail.description')}</h2>
            <div class="prose prose-gray max-w-none" set:html={sanitizeHtml(description)} />
          </div>
        </div>

        <!-- 右侧：联系卡片 -->
        <div class="lg:col-span-1">
          <div class="sticky top-24 bg-gray-50 rounded-2xl p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-3">{t('contact.interested')}</h3>
            <p class="text-gray-600 mb-6 text-sm">{t('contact.interestedDesc')}</p>
            <button
              data-modal-trigger="contact-modal"
              class="w-full px-6 py-4 bg-estate-500 text-white rounded-lg font-semibold hover:bg-estate-600 transition-colors flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              {t('estate.detail.contact')}
            </button>

            <!-- 所在地 -->
            <div class="mt-6 pt-6 border-t border-gray-200">
              <p class="text-xs text-gray-400 mb-1">{t('estate.detail.location')}</p>
              <p class="text-sm text-gray-700">{location}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactModal />
</BaseLayout>
