---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, getLocalizedContent, type Lang } from '@/i18n';
import { getCollection } from 'astro:content';

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const allProperties = await getCollection('properties');
const featuredProperties = allProperties.filter((p) => p.data.featured);
const otherProperties = allProperties.filter((p) => !p.data.featured);
const sortedProperties = [...featuredProperties, ...otherProperties];
---

<BaseLayout title={t('estate.hero.title')} theme="estate">
  <!-- Hero Section -->
  <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden bg-gradient-to-br from-neutral-900 via-neutral-800 to-neutral-900">
    <!-- 金色装饰 -->
    <div class="absolute inset-0">
      <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-estate-500 to-transparent"></div>
      <div class="absolute top-1/3 right-0 w-64 h-64 bg-estate-500/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-1/4 left-1/4 w-48 h-48 bg-estate-400/10 rounded-full blur-3xl"></div>
    </div>

    <div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 border border-estate-500/30 rounded-full px-4 py-2 mb-6">
        <span class="w-2 h-2 bg-estate-500 rounded-full"></span>
        <span class="text-estate-300 text-sm font-medium tracking-wider uppercase">Real Estate</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-6">
        {t('estate.hero.title')}
      </h1>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">
        {t('estate.hero.subtitle')}
      </p>
    </div>
  </section>

  <!-- 项目列表 -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-bold text-gray-900 mb-12 text-center">{t('estate.projects.title')}</h2>

      {sortedProperties.length === 0 ? (

        <div class="text-center py-24 text-gray-400">
          <svg class="w-16 h-16 mx-auto mb-4 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <p class="text-lg">{t('estate.projects.empty')}</p>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedProperties.map((property) => {
            const title = getLocalizedContent(property.data.title, lang) || '';
            const location = getLocalizedContent(property.data.location, lang) || '';
            const mainImage = property.data.images?.[0];
            const imageSrc = mainImage
              ? (typeof mainImage === 'string' ? mainImage : mainImage.src)
              : null;
            const propertySlug = property.id.split('/')[0];

            return (
              <a
                href={`/${lang}/estate/${propertySlug}`}
                class="group bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col"
              >
                <!-- 图片 -->
                <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-estate-100 to-estate-200">
                  {imageSrc ? (
                    <img
                      src={imageSrc}
                      alt={title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center">
                      <svg class="w-16 h-16 text-estate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                      </svg>
                    </div>
                  )}
                  {property.data.featured && (
                    <div class="absolute top-4 left-4">
                      <span class="px-3 py-1 bg-estate-500 text-white text-xs font-semibold rounded-full">
                        {t('estate.featured')}
                      </span>
                    </div>
                  )}
                </div>

                <!-- 信息 -->
                <div class="p-6 flex flex-col flex-1">
                  <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-estate-600 transition-colors">
                    {title}
                  </h3>
                  <p class="text-gray-500 text-sm flex items-center gap-1 mb-4">
                    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    {location}
                  </p>
                  <div class="mt-auto flex items-center text-estate-600 font-medium text-sm group-hover:gap-2 gap-1 transition-all">
                    <span>{t('common.learnMore')}</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
