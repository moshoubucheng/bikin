---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '@/i18n';
import ContactModal from '@/components/ContactModal.astro';

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const content = {
  zh: {
    heroDesc: '随着AI算力需求的爆发，日本数据中心正面临残酷现实：东京和大阪的电网接入等待期长达5至10年，而超大型云服务商的资本已经到位。算力的尽头，是电力。美錦エネルギー让数据中心先于电网并网。',
    aboutP1: '美錦エネルギー株式会社立足日本市场，背靠中国美锦能源集团——中国最大的独立商品焦和炼焦煤生产商之一、氢能全产业链布局的头部企业（深交所上市，代码000723）。集团旗下飞驰科技是中国领先的氢燃料电池商用车制造商，产品已出口至以色列、智利等全球市场。',
    aboutP2: '核心壁垒：母集团宁夏灵武30万吨/年低碳甲醇一体化项目（总投资109.8亿元人民币），采用全球独创的「生物质气化+焦炉副产氢+碳捕集（CCUS）」耦合路线，实现全球最低分位的低碳甲醇生产成本。从中国北方港口至日本仅需5至10天短途海运，到岸成本远低于欧洲和澳大利亚竞品。',
    sol1Desc: '通过「低碳甲醇供应+甲醇蒸汽重整制氢+质子交换膜燃料电池（PEMFC）发电」的端到端架构，为数据中心提供不依赖大电网的兆瓦级零碳基载电力。系统从250kW模块化起步，可扩展至数十兆瓦。',
    sol1Points: ['甲醇常温常压储运，安全性远优于锂电池和高压氢气', '重整温度仅200–300°C，数分钟内达满负荷出力', '250kW 模块起步，可扩展至数十兆瓦'],
    sol2Desc: '以低碳甲醇燃料电池系统全面替代传统柴油发电机，消除安全隐患和废气污染，让数据中心最后一环也实现真正的零碳排放。燃料电池10秒内启动响应，同时可参与电网平衡（Balancing Market），为运营商创造额外收益。',
    sol2Points: ['10秒内启动响应，满足数据中心苛刻要求', '可参与电网平衡市场，创造额外收益', '已在本田、德山、三菱商事联合示范项目中验证'],
    sol3Desc: '为客户打通日本《氢能社会推进法》下GX CfD补贴申请全流程：从METI的事业计划认定到JOGMEC的补贴拨付，提供ISCC PLUS碳认证追溯、绿证及绿电PPA交易链路对接，帮助运营商将补贴后度电成本降至低于商业网电价格。',
    sol3Points: ['从METI事业计划认定到JOGMEC补贴拨付全程护航', 'ISCC PLUS认证可溯源碳中和合规报告', '补贴后度电成本约 0.147–0.157 美元/kWh'],
    why1Desc: '母集团宁夏灵武低碳甲醇项目出厂成本仅440–480美元/吨，属全球最低分位。相比纯电解水制氢绿色甲醇（$800–$1,000/吨），成本约为其50%，形成竞争对手无法复制的价格壁垒。',
    why2Desc: '我们正积极与本田和丰田推进日本市场战略合作洽谈。本田第三代FC模块（150kW、成本减半、耐久翻倍）2027年量产，静态发电站2026年商业化，250kW至3MW可扩展——其产品能力与美锦方案高度契合。丰田FC技术同样成熟且灵活，可按分布式发电场景定制，是数据中心基载电力供应的理想选型。',
    why3Desc: '扎根大阪，熟稔日本电力市场规则、GX政策、《消防法》危化品管理及《建筑基准法》合规要求，提供从方案设计到GX补贴申报的无缝本土化服务。',
    why4Desc: 'GX CfD补贴总额3万亿日元、期限15年。日本GX体系以碳强度（CI）为核心指标，不要求欧盟式纯绿溯源——美锦方案完全符合JOGMEC补贴资格。叠加2026年GX-ETS碳交易及2028年化石燃料碳附加费，经济优势持续放大。',
    why5Desc: '相比传统解决商动辄数年的周期，美锦以模块化集装箱式部署方案，从方案确认到首批电力输出，目标周期压缩至数月级别。对于急于上线的AI数据中心客户，时间就是一切。',
    why6Desc: '美锦「生物质气化+焦炉副产氢+CCUS」耦合路线符合ISCC PLUS质量平衡体系，可认证为"生物质-循环甲醇（Bio-Circular Methanol）"。虽有别于欧盟ISCC EU，但日本GX以碳强度（CI）为准绳，ISCC PLUS足以解锁全部JOGMEC补贴与市场溢价，且无任何漂绿合规风险，更是巴斯夫、陶氏等亚太工业买家广泛认可的ESG凭证。',
    tableRows: [
      ['低碳甲醇产能', '30万吨/年（一期20万吨，2027年底投产）'],
      ['项目总投资', '109.8 亿元人民币'],
      ['出厂成本优势', '约 $440–480/吨（纯电解甲醇 $800–$1,000/吨的约50%）'],
      ['CIF 日本到岸成本', '470–530 美元/吨'],
      ['中国至日本海运', '5–10 天近海短途航线'],
      ['日本 GX CfD 补贴', '3 万亿日元规模，15 年期'],
      ['GX-ETS 碳价', '1,700–4,300 日元/吨CO₂（2026年首年）'],
      ['补贴后度电成本', '约 0.147–0.157 美元/kWh（低于网电）'],
      ['日本数据中心电力缺口', '19 TWh → 66 TWh（2024→2034年）'],
      ['ISCC 认证路径', 'ISCC PLUS（Bio-Circular Methanol），符合日本GX CI阈值'],
    ],
    ctaDesc: '联系我们，获取专属方案咨询',
  },
  ja: {
    heroDesc: 'AIの急速な普及に伴い、日本のデータセンターは深刻な現実に直面しています。東京・大阪での系統接続待機期間は5〜10年に及ぶ一方、ハイパースケーラーの投資資金はすでに揃っています。算力の限界は、電力です。美錦エネルギーはデータセンターを電力網より先に稼働させます。',
    aboutP1: '美錦エネルギー株式会社は日本市場を拠点とし、中国の美錦エネルギーグループ（深証上場、証券コード000723）を母体としています。グループは中国最大規模の独立系冶金コークス・原料炭生産企業の一つであり、水素エネルギー全産業チェーンをカバーするリーディングカンパニーです。グループ傘下の飛馳科技は中国トップの水素燃料電池商用車メーカーで、製品はイスラエル、チリなどのグローバル市場に輸出されています。',
    aboutP2: '中核的な競争優位性：母グループの寧夏霊武30万トン/年低炭素メタノール一体化プロジェクト（総投資額109.8億元）は、世界独自の「バイオマスガス化＋コークス炉副生水素＋炭素回収（CCUS）」カップリング技術を採用し、世界最低水準の低炭素メタノール製造コストを実現。中国北部港から日本まで5〜10日の近海輸送で到着します。',
    sol1Desc: '「低炭素メタノール供給＋メタノール水蒸気改質水素製造＋PEM燃料電池発電」のエンドツーエンドアーキテクチャにより、大規模電力網に依存しないメガワット級ゼロカーボンベース電力をデータセンターに供給します。250kWのモジュール式から開始し、数十MWまでスケール可能です。',
    sol1Points: ['常温常圧でのメタノール貯蔵・輸送、リチウム電池や高圧水素より安全', '改質温度200〜300°C、数分でフル出力到達', '250kW モジュールから数十MW までスケーラブル'],
    sol2Desc: '低炭素メタノール燃料電池システムで従来のディーゼル発電機を全面代替します。安全リスクと排気汚染を解消し、データセンターの最後の領域でも真のゼロカーボンを実現。燃料電池は10秒以内に起動し、系統調整市場にも参加可能です。',
    sol2Points: ['10秒以内に起動応答、データセンターの厳しい要求に対応', '系統調整（バランシングマーケット）参加で追加収益を創出', '本田・徳山・三菱商事の合同実証プロジェクトで検証済み'],
    sol3Desc: '水素社会推進法に基づくGX CfD補助金申請の全プロセスをサポート。METIの事業計画認定からJOGMECの補助金支払いまで、ISCC PLUS炭素認証、グリーン証書、グリーン電力PPA取引リンクを提供し、補助金後の電力コストを商業系統電力価格以下に抑えます。',
    sol3Points: ['METIの事業計画認定からJOGMECの補助金支払いまで完全サポート', 'ISCC PLUS認証による追跡可能なコンプライアンスレポート', '補助金後の電力コスト約0.147〜0.157米ドル/kWh'],
    why1Desc: '母グループの低炭素メタノールプロジェクトの出荷コストは440〜480米ドル/トンと世界最低水準。電解水素グリーンメタノール（$800〜$1,000/トン）の約50%のコストであり、競合他社が再現できない価格競争力を形成しています。',
    why2Desc: '本田・トヨタとの日本市場における戦略的パートナーシップ締結に向け、積極的に協議を推進中。本田第3世代FCモジュール（150kW、コスト半減、耐久性2倍）は2027年量産予定、定置発電所は2026年商業化、250kW〜3MWのスケーラブル対応——その製品能力は美錦のソリューションと高い適合性を持つ。トヨタのFC技術も同様に成熟・柔軟であり、分散型発電シナリオへのカスタマイズが容易で、データセンターのベースロード電力需要に最適な選択肢となる。',
    why3Desc: '大阪を拠点に、日本の電力市場規制、GX政策、消防法の危険物管理、建築基準法のコンプライアンスに精通。方案設計からGX補助金申請まで、シームレスなローカルサービスを提供します。',
    why4Desc: 'GX CfD補助金は総額3兆円、期間15年。日本GX体系は炭素強度（CI）を核心指標とし、欧州式の純グリーン溯源を要求しません。美錦の方案はJOGMEC補助金資格を完全に満たし、GX-ETS炭素取引（2026年）と化石燃料炭素賦課金（2028年）の追加で経済優位性は拡大し続けます。',
    why5Desc: '従来のソリューションプロバイダーが数年かかるプロジェクト期間に比べ、美錦はモジュール式コンテナ型展開により、方案確定から最初の電力出力まで数ヶ月レベルを目標としています。AI データセンターにとって、時間はすべてです。',
    why6Desc: '美錦の「バイオマスガス化＋コークス炉副生水素＋CCUS」カップリング技術はISCC PLUS質量平衡体系に適合し、「バイオマス-循環メタノール（Bio-Circular Methanol）」として認証取得が可能です。欧州ISCC EUとは異なりますが、炭素強度（CI）基準の日本GX市場ではISCC PLUSで全補助金と市場プレミアムを解锁でき、グリーンウォッシュリスクもゼロ。BASF・ダウなど亜太工業バイヤーにも広く認められたESG証明書です。',
    tableRows: [
      ['低炭素メタノール生産能力', '30万トン/年（第1期20万トン、2027年末稼働予定）'],
      ['プロジェクト総投資額', '109.8億元（人民元）'],
      ['製造コスト優位性', '約$440〜480/トン（電解メタノールの約50%）'],
      ['日本 CIF 到着コスト', '470〜530米ドル/トン'],
      ['中国〜日本海上輸送', '5〜10日の近海航路'],
      ['日本 GX CfD 補助金', '3兆円規模、15年間'],
      ['GX-ETS 炭素価格', '1,700〜4,300円/トンCO₂（2026年初年度）'],
      ['補助金後の電力コスト', '約0.147〜0.157米ドル/kWh（系統電力より低い）'],
      ['日本DCの電力不足', '19 TWh → 66 TWh（2024→2034年）'],
      ['ISCC 認証パス', 'ISCC PLUS（Bio-Circular Methanol）、日本GX CI基準適合'],
    ],
    ctaDesc: 'お気軽にお問い合わせください。専用ソリューションをご提案します。',
  },
  en: {
    heroDesc: "As AI computing demand explodes, Japan's data centers face a brutal reality: grid connection wait times in Tokyo and Osaka stretch 5 to 10 years, while hyperscaler capital is already deployed. The limit of compute is power. Meijin Energy brings data centers online before the grid does.",
    aboutP1: "Meijin Energy Co., Ltd. operates from Japan, backed by China's Meijin Energy Group — one of China's largest independent met coke and coking coal producers with a full hydrogen value chain footprint (Shenzhen Exchange: 000723). The group's Feichi Technology is China's leading hydrogen fuel cell commercial vehicle maker, with exports to Israel, Chile, and beyond.",
    aboutP2: "Our core moat: the parent group's Ningxia Lingwu 300,000-ton/year low-carbon methanol integrated project (total investment CNY 10.98 billion) uses a globally unique biomass gasification + coke oven by-product hydrogen + CCUS coupling process — achieving world-leading-low production costs at roughly half the cost of pure electrolysis-based green methanol.",
    sol1Desc: "An end-to-end architecture of low-carbon methanol supply → on-site steam reforming → PEMFC power generation delivers megawatt-scale zero-carbon baseload power without grid dependency. Modular from 250kW, scalable to tens of megawatts.",
    sol1Points: ['Ambient-pressure methanol storage — safer than large-scale batteries or high-pressure H₂', 'Reforming at just 200–300°C; full output reached within minutes', 'Scales from 250kW module to tens of megawatts'],
    sol2Desc: "Fully replace diesel generators with low-carbon methanol fuel cell systems. Eliminate fuel storage hazards and exhaust emissions, achieving genuine zero-carbon operations at the last mile. Fuel cells start in under 10 seconds and can participate in the balancing market to generate additional revenue.",
    sol2Points: ['10-second startup meets data center SLA requirements', 'Balancing market participation creates additional revenue streams', 'Validated in Honda / Tokuyama / Mitsubishi Corporation joint demonstration'],
    sol3Desc: "Full-service support for Japan's GX CfD subsidy applications under the Hydrogen Society Promotion Act — from METI project certification to JOGMEC disbursement, with ISCC PLUS carbon certification, green certificates, and green power PPA trading links. Bringing post-subsidy levelized cost below commercial grid rates.",
    sol3Points: ['End-to-end support from METI certification to JOGMEC disbursement', 'ISCC PLUS-certified traceable carbon-neutral compliance reporting', 'Post-subsidy levelized cost ~$0.147–0.157/kWh'],
    why1Desc: "Parent group's low-carbon methanol plant produces at $440–480/ton — globally lowest-quartile, roughly half the cost of pure electrolysis-based green methanol ($800–$1,000/ton). An unmatched price moat that competitors relying on renewable-power electrolysis simply cannot replicate.",
    why2Desc: "We are actively pursuing strategic partnerships with both Honda and Toyota for the Japan market. Honda's 3rd-gen FC module (150kW, halved cost, doubled durability) enters mass production in 2027 with stationary generation commercializing in 2026 at scalable 250kW–3MW — a product capability that aligns closely with Meijin's solution architecture. Toyota's FC technology is equally mature and flexible, readily customizable for distributed power generation, making it an ideal candidate for data center baseload supply.",
    why3Desc: 'Osaka-based team fluent in Japan grid regulations, GX green transformation policy, Fire Services Act hazmat management, and Building Standards Act compliance — delivering seamless local service from solution design through GX subsidy filing.',
    why4Desc: "GX CfD subsidy pool: ¥3 trillion over 15 years. Japan's GX framework measures carbon intensity (CI) — not European-style pure-green provenance. Meijin's solution fully qualifies for JOGMEC subsidies, with economics further strengthened by GX-ETS carbon trading (2026) and fossil fuel carbon surcharge (2028).",
    why5Desc: "While incumbents take years, Meijin's modular containerized deployment targets months from contract to first power output — critical for AI data center clients where time-to-market is everything.",
    why6Desc: "Meijin's biomass gasification + coke oven by-product H₂ + CCUS coupling qualifies for ISCC PLUS mass-balance certification as \"Bio-Circular Methanol\" — a rigorous, globally recognized third-party standard. While distinct from ISCC EU, ISCC PLUS fully satisfies Japan's GX carbon-intensity (CI) thresholds, unlocks JOGMEC subsidies, and carries zero greenwashing risk. It is also widely accepted by Asian industrial buyers (BASF, Dow, etc.) for ESG compliance.",
    tableRows: [
      ['Low-Carbon Methanol Capacity', '300,000 tons/year (Phase 1: 200,000t, online late 2027)'],
      ['Total Project Investment', 'CNY 10.98 billion'],
      ['Production Cost Advantage', '~$440–480/ton (vs. ~$800–$1,000/ton for pure e-methanol)'],
      ['Japan CIF Cost', '$470–530/ton'],
      ['China→Japan Shipping', '5–10 days coastal route'],
      ['Japan GX CfD Subsidy', '¥3 trillion pool, 15-year term'],
      ['GX-ETS Carbon Price', '¥1,700–4,300/ton CO₂ (2026 first year)'],
      ['Post-Subsidy Levelized Cost', '~$0.147–0.157/kWh (below grid rate)'],
      ['Japan DC Power Gap', '19 TWh → 66 TWh (2024→2034)'],
      ['ISCC Certification Path', 'ISCC PLUS (Bio-Circular Methanol), meets Japan GX CI threshold'],
    ],
    ctaDesc: 'Contact us for a customized solution consultation.',
  },
};

const c = content[lang];
---

<BaseLayout title={t('energy.hero.title')} theme="energy">

  <!-- ═══════════════════════════════════════════
       HERO SECTION
  ═══════════════════════════════════════════ -->
  <section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-energy-950 via-energy-900 to-slate-900">
    <!-- Grid background -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#1e40af12_1px,transparent_1px),linear-gradient(to_bottom,#1e40af12_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
    <!-- Glow orbs -->
    <div class="absolute top-1/4 left-1/3 w-[500px] h-[500px] bg-energy-600/15 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-1/4 right-1/4 w-[350px] h-[350px] bg-cyan-500/10 rounded-full blur-[100px]"></div>

    <div class="relative z-10 text-center px-4 max-w-5xl mx-auto py-24">
      <!-- Tag -->
      <div class="inline-flex items-center gap-2 bg-energy-500/15 border border-energy-500/30 rounded-full px-5 py-2 mb-8">
        <span class="w-1.5 h-1.5 bg-energy-400 rounded-full animate-pulse"></span>
        <span class="text-energy-300 text-sm font-medium tracking-widest uppercase">{t('energy.tagline')}</span>
      </div>

      <!-- Main title -->
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
        {t('energy.hero.title')}
      </h1>

      <!-- Subtitle -->
      <p class="text-xl md:text-2xl text-energy-200 mb-6 font-light">
        {t('energy.hero.subtitle')}
      </p>

      <!-- Description -->
      <p class="text-base md:text-lg text-energy-300/80 mb-10 max-w-3xl mx-auto leading-relaxed">
        {c.heroDesc}
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`#solutions`}
          class="inline-flex items-center gap-2 bg-energy-500 hover:bg-energy-400 text-white font-semibold px-8 py-4 rounded-xl transition-all duration-200 shadow-lg shadow-energy-500/30 hover:shadow-energy-400/40 hover:-translate-y-0.5"
        >
          {t('energy.hero.cta')}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
        <button
          data-modal-trigger="contact-modal"
          class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 border border-white/20 text-white font-semibold px-8 py-4 rounded-xl transition-all duration-200 backdrop-blur-sm"
        >
          {t('nav.contact')}
        </button>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-energy-400/60">
      <span class="text-xs tracking-widest uppercase">{lang === 'ja' ? 'スクロール' : lang === 'en' ? 'Scroll' : '向下浏览'}</span>
      <div class="w-px h-8 bg-gradient-to-b from-energy-400/60 to-transparent"></div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       PAIN POINT STATS BAR
  ═══════════════════════════════════════════ -->
  <section class="bg-energy-900 border-y border-energy-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <h2 class="text-center text-energy-400 text-sm font-semibold tracking-widest uppercase mb-10">
        {t('energy.pain.title')}
      </h2>
