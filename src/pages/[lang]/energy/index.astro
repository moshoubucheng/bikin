      </div>

      <div class="rounded-2xl overflow-hidden border border-energy-800">
        <table class="w-full">
          <thead>
            <tr class="bg-energy-900 border-b border-energy-800">
              <th class="text-left text-energy-400 text-xs font-semibold tracking-widest uppercase px-6 py-4 w-1/2">{t('energy.data.metric')}</th>
              <th class="text-left text-energy-400 text-xs font-semibold tracking-widest uppercase px-6 py-4 w-1/2">{t('energy.data.value')}</th>
            </tr>
          </thead>
          <tbody>
            {c.tableRows.map((row, i) => (
              <tr class={`border-b border-energy-900 ${i % 2 === 0 ? 'bg-energy-950' : 'bg-energy-900/40'} hover:bg-energy-800/40 transition-colors`}>
                <td class="px-6 py-4 text-energy-300 text-sm">{row[0]}</td>
                <td class="px-6 py-4 text-white text-sm font-medium">{row[1]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-center text-xs text-energy-600">
        ℹ {t('energy.data.disclaimer')}
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       FAQ SECTION
  ═══════════════════════════════════════════ -->
  <section id="faq" class="py-24 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">
          {c.faqTitle}
        </h2>
        <div class="w-12 h-0.5 bg-energy-500 mx-auto mt-4"></div>
      </div>

      <dl class="space-y-6">
        {c.faqs.map(({ q, a }) => (
          <div class="border border-gray-200 rounded-2xl p-6 hover:border-energy-300 transition-colors">
            <dt class="text-base font-semibold text-gray-900 mb-3">{q}</dt>
            <dd class="text-gray-600 text-sm leading-relaxed">{a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CTA SECTION
  ═══════════════════════════════════════════ -->
  <section class="py-24 bg-gradient-to-br from-energy-700 via-energy-600 to-cyan-700 relative overflow-hidden">
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff08_1px,transparent_1px),linear-gradient(to_bottom,#ffffff08_1px,transparent_1px)] bg-[size:3rem_3rem]"></div>
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-white/5 rounded-full blur-3xl"></div>

    <div class="relative z-10 text-center max-w-2xl mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        {t('energy.cta.title')}
      </h2>
      <p class="text-energy-100 text-lg mb-10">
        {c.ctaDesc}
      </p>
      <button
        data-modal-trigger="contact-modal"
        class="inline-flex items-center gap-3 bg-white text-energy-700 font-bold px-10 py-4 rounded-xl hover:bg-energy-50 transition-colors shadow-xl shadow-energy-900/30 text-lg"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        {t('energy.cta.button')}
      </button>
    </div>
  </section>

  <ContactModal />

</BaseLayout>
